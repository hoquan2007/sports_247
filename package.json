{
  "name": "sports247-football-live",
  "version": "1.0.0",
  "private": true,
  "description": "Sports247 real-time football schedule and live scores",
  "author": "Sports247",
  "license": "UNLICENSED",
  "keywords": [
    "sports",
    "football",
    "live-scores",
    "fixtures",
    "nextjs",
    "tailwindcss"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "smoke:local": "node scripts/smoke-http.mjs",
    "monitor:production": "node scripts/monitor-production.mjs",
    "audit:browser": "node scripts/audit-browser.mjs",
    "qa:local": "node scripts/qa-local.mjs",
    "qa:browser": "node scripts/qa-browser.mjs",
    "audit:logos": "node scripts/audit-league-logos.mjs",
    "audit:data": "node scripts/audit-data-coverage.mjs",
    "audit:readiness": "node --env-file-if-exists=.env.local scripts/audit-readiness.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.6.0",
    "motion": "^14.9.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.11.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
