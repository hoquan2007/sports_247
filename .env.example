# Optional Vietnamese professional-league fixture feed. Obtain and verify season-specific
# numeric IDs from API-Football; without ALL three values, the provider stays disabled.
API_FOOTBALL_KEY=
SPORTS247_VLEAGUE1_ID=
SPORTS247_VLEAGUE2_ID=
# Seconds between server-side provider refreshes; reduce only after quota review.
SPORTS247_VIETNAM_CACHE_SECONDS=3600

# Optional licensed live-video feed. Leave BOTH empty until written permission to
# embed specific competitions in specific viewer countries has been verified.
SCOREBAT_API_TOKEN=
SCOREBAT_LICENSED_MARKETS=

# Optional GLOBAL reservation cap for ScoreBat API calls and iframe handoffs.
# Set all three together when a paid subscription is active. Without these
# values the integration remains unmetered. Partial setup fails closed.
SCOREBAT_MONTHLY_CREDIT_LIMIT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional authorized per-event YouTube embeds. Keep [] until each video has an
# event ID, authorized countries, UTC validity window and rightsReference.
# Format and validation rules: README.md -> Trực tiếp / OFFICIAL_YOUTUBE_STREAMS.
OFFICIAL_YOUTUBE_STREAMS=[]
